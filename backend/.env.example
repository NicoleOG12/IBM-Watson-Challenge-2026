# Application
APP_NAME=AI Data Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# IBM watsonx.ai
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_MAX_NEW_TOKENS=512
WATSONX_TEMPERATURE=0.0
# Set to False when real credentials are provided
WATSONX_MOCK=True

# IBM Consulting Advantage (ICA)
# Developer keys: ICA UI → Settings → API Keys → ICA APIs
ICA_KEY=your-ica-developer-api-key
ICA_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1
# Chat model to use for NL→SQL via /chat-models/chat/completions
# Options seen in your account: meta-llama/llama-4-maverick-17b-128e-instruct-fp8 | claude-sonnet-4-5 | gpt-5.1-chat-gus
ICA_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
# Set to False to route NL→SQL through the real ICA API
ICA_MOCK=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/copilot
# Set to False when a real database connector is registered
DB_MOCK=True

# AWS Athena (production query execution)
# Set USE_ATHENA=True to route queries through real AWS Athena
USE_ATHENA=False
ATHENA_DB=default
ATHENA_OUTPUT=s3://your-bucket/athena-results/
AWS_REGION=us-east-1

# Conversation memory
MEMORY_MAX_HISTORY=10

# Anomaly detection thresholds
# Coefficient of variation (%) above which a column is flagged as highly variable
ANOMALY_VARIATION_THRESHOLD=30.0
# IQR fence multiplier for outlier detection (standard Tukey = 1.5; lower = stricter)
ANOMALY_IQR_MULTIPLIER=1.5

# Audit logging
AUDIT_ENABLED=True
AUDIT_LOG_FILE=logs/audit.log

# Vector Store (Pinecone)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws

# Security
SECRET_KEY=change-me-in-production
